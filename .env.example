# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SMTP Settings for Notifications (Receipts, Invoices, Alerts)
# To use Gmail: Host=smtp.gmail.com, Port=587, User=your-email@gmail.com, Pass=16-character-app-password
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Royal ERP POS <notifications@royalpos.io>"
 
# Enterprise Rate Limiting & Threat Protection Configuration
RATE_LIMIT_AUTH_WINDOW_MS=300000
RATE_LIMIT_AUTH_MAX=15
RATE_LIMIT_PUBLIC_WINDOW_MS=60000
RATE_LIMIT_PUBLIC_MAX=120
RATE_LIMIT_ACTION_WINDOW_MS=60000
RATE_LIMIT_ACTION_MAX=600
RATE_LIMIT_GLOBAL_MAX=2000
