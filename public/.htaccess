<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1. Allow existing files and directories to be served directly
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 2. Rewrite nested assets requests (e.g. /contacts/assets/file.js -> /assets/file.js)
  RewriteRule ^(.*)/assets/(.*)$ assets/$2 [L,QSA]

  # 3. Direct system API routing (works in root, /farm/, or nested routes)
  RewriteRule ^(.*)/?api/system/status/?$ api/system.php?action=status [QSA,L]
  RewriteRule ^(.*)/?api/system/install/?$ api/system.php?action=install [QSA,L]
  RewriteRule ^(.*)/?api/system/reset/?$ api/system.php?action=reset [QSA,L]
  RewriteRule ^(.*)/?api/system/?$ api/system.php [QSA,L]
  RewriteRule ^(.*)/?api/sync/?$ api/sync.php [QSA,L]

  # 4. SPA fallback to index.html (relative - safe for subfolders and root)
  RewriteRule ^index\.html$ - [L]
  RewriteRule . index.html [L]
</IfModule>
